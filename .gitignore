local.properties
google-services.json

# Signing keys
*.jks
*.keystore

# Android artifacts
*.apk
*.ap_
*.aab

# NDK / native build
.externalNativeBuild/
.cxx/
obj/
*.so

# Profiling / captures
captures/
*.hprof
*.trace

# Test / coverage
test-results/
coverage/

# OS files
.DS_Store
Thumbs.db

# Misc
*.log
*.tmp
*.bak
*.orig
