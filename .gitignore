# Gradle / build
.gradle/
**/build/

# Gradle wrapper (keep wrapper files in repo)
# gradle/wrapper/gradle-wrapper.jar
# gradle/wrapper/gradle-wrapper.properties

# Android Studio / IntelliJ
/.idea/
*.iml

# If you want to share code styles or inspection profiles, un-ignore them:
